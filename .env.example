# Copier en .env.local et compléter. Ne jamais committer de valeurs réelles.
# Voir guides/guide.md, étape « Base de données locale ».

# Connexion de l'application : rôle optima_app (sans BYPASSRLS, D-016).
DATABASE_URL=postgresql://optima_app:A_REMPLACER@localhost:5432/optima

# Connexion des migrations : rôle optima_migrator (propriétaire du schéma).
MIGRATION_DATABASE_URL=postgresql://optima_migrator:A_REMPLACER@localhost:5432/optima

# Clé de chiffrement des secrets de double authentification : 32 octets en base64.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=A_REMPLACER

# Origine publique (obligatoire en production), par exemple https://optima.exemple.cd
APP_ORIGIN=http://localhost:3000

# Indexation de la landing page (D-Q01) : false par défaut.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Exports PDF : navigateur utilisé par playwright-core (aucun navigateur n'est téléchargé).
# En local : un Chrome ou un Edge installé (canal « chrome » par défaut, ou « msedge »).
# En production (Docker) : chemin de Chromium, par exemple /usr/bin/chromium.
# PDF_BROWSER_CHANNEL=chrome
# PDF_BROWSER_PATH=/usr/bin/chromium
